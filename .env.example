# Go builder image used by the multi-stage Docker build.
GO_IMAGE=golang:1.26-alpine
# Minimal runtime image containing the compiled application.
RUNTIME_IMAGE=alpine:3.23
# PostgreSQL image used by the local Compose stack.
POSTGRES_IMAGE=postgres:17-alpine
# Name and tag assigned to the locally built uploader image.
UPLOADER_IMAGE=pal-nas-media-uploader:local
# Docker build context, relative to build/compose.yaml.
BUILD_CONTEXT=..
# Dockerfile path, relative to the build context.
DOCKERFILE_PATH=build/Dockerfile

# PostgreSQL database created when the container starts.
POSTGRES_DB=uploader
# PostgreSQL application user.
POSTGRES_USER=uploader
# PostgreSQL password; replace this value for your environment.
POSTGRES_PASSWORD=change-me
# PostgreSQL Compose service hostname used inside the Docker network.
POSTGRES_HOST=postgres
# PostgreSQL port exposed on the host machine.
POSTGRES_HOST_PORT=5432
# PostgreSQL port used inside the Docker network.
POSTGRES_CONTAINER_PORT=5432
# Persistent PostgreSQL data directory inside the container.
POSTGRES_DATA_DIR=/var/lib/postgresql/data
# PostgreSQL TLS mode for the application connection.
POSTGRES_SSLMODE=disable
# Delay between PostgreSQL health checks.
POSTGRES_HEALTH_INTERVAL=5s
# Maximum duration allowed for each PostgreSQL health check.
POSTGRES_HEALTH_TIMEOUT=3s
# Failed health checks allowed before PostgreSQL is unhealthy.
POSTGRES_HEALTH_RETRIES=10
# Docker Compose restart policy for the uploader service.
COMPOSE_RESTART_POLICY=unless-stopped

# Gin runtime mode: debug, release, or test.
ENV_GIN_MODE=release
# HTTP port used by the uploader container and exposed on the host.
ENV_PORT=8081
# Initial administrator username created when the users table is empty.
ENV_ADMIN_USERNAME=admin
# Initial administrator password; must contain at least 12 characters.
ENV_ADMIN_PASSWORD=change-me-at-least-12-characters
# PostgreSQL connection URL assembled from the settings above.
ENV_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_CONTAINER_PORT}/${POSTGRES_DB}?sslmode=${POSTGRES_SSLMODE}
# Directory where completed media files are stored inside the container.
ENV_MEDIA_DIR=/data/medias
# Directory where upload metadata and incomplete chunks are stored.
ENV_TMP_DIR=/data/tmp
# Maximum accepted media size in bytes (100 GiB in this example).
ENV_MAX_UPLOAD_SIZE_BYTES=107374182400
# Comma-separated browser origins allowed to call the API.
ENV_CORS_ALLOWED_ORIGINS=http://localhost:3000
# TOTP issuer displayed by authenticator applications.
ENV_ISSUER=local.pal-media-uploader
